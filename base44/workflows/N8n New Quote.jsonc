{
  "name": "N8n - Nouvelle demande de devis",
  "description": "Transmet chaque nouvelle demande de devis \u00e0 n8n.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "QuoteRequest",
      "events": [
        "create"
      ]
    },
    "condition": null
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "n8n_new_quote",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_to_n8n": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendN8nWebhook",
            "args": {
              "entity_name": "QuoteRequest",
              "entity_id": "${ .trigger.entity_id }",
              "event_name": "quote_request.created"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Envoyer le devis \u00e0 n8n",
            "description": "Webhook sign\u00e9 et d\u00e9dupliqu\u00e9"
          }
        }
      }
    ]
  }
}