{
  "name": "ExtraRecommendation",
  "type": "object",
  "properties": {
    "extra_id": {
      "type": "string"
    },
    "caterer_id": {
      "type": "string"
    },
    "caterer_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    },
    "mission_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "extra_id",
    "caterer_id",
    "caterer_name",
    "rating",
    "comment"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}