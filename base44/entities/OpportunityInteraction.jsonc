{
  "name": "OpportunityInteraction",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "request_kind": {
      "type": "string",
      "enum": [
        "quote",
        "urgent"
      ]
    },
    "caterer_id": {
      "type": "string"
    },
    "interaction_type": {
      "type": "string",
      "enum": [
        "view",
        "response"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "request_kind",
    "caterer_id",
    "interaction_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}