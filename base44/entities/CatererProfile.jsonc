{
  "name": "CatererProfile",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "changes_requested",
        "approved",
        "suspended",
        "rejected"
      ],
      "default": "draft"
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "demo": {
      "type": "boolean",
      "default": false
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "profile_origin": {
      "type": "string",
      "enum": [
        "owner",
        "public_source"
      ]
    },
    "source_url": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "siret": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "service_radius_km": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "event_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cuisines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dietary_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        },
        "required": [
          "question",
          "answer"
        ]
      }
    },
    "min_guests": {
      "type": "number"
    },
    "max_guests": {
      "type": "number"
    },
    "price_from_per_person": {
      "type": "number"
    },
    "minimum_order": {
      "type": "number"
    },
    "average_response_hours": {
      "type": "number"
    },
    "years_experience": {
      "type": "number"
    },
    "logo_url": {
      "type": "string"
    },
    "hero_image": {
      "type": "string"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "google_rating": {
      "type": "number"
    },
    "google_review_count": {
      "type": "number"
    },
    "google_reviews_url": {
      "type": "string"
    }
  },
  "required": [
    "business_name",
    "slug",
    "status",
    "published",
    "city"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.published": true
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}