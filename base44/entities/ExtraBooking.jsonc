{
  "name": "ExtraBooking",
  "type": "object",
  "properties": {
    "extra_profile_id": {
      "type": "string"
    },
    "extra_user_id": {
      "type": "string"
    },
    "extra_name": {
      "type": "string"
    },
    "extra_phone": {
      "type": "string"
    },
    "extra_email": {
      "type": "string"
    },
    "extra_city": {
      "type": "string"
    },
    "extra_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extra_experience": {
      "type": "string"
    },
    "caterer_id": {
      "type": "string"
    },
    "caterer_name": {
      "type": "string"
    },
    "caterer_slug": {
      "type": "string"
    },
    "caterer_contact_name": {
      "type": "string"
    },
    "caterer_phone": {
      "type": "string"
    },
    "caterer_email": {
      "type": "string"
    },
    "caterer_address": {
      "type": "string"
    },
    "caterer_city": {
      "type": "string"
    },
    "booking_date": {
      "type": "string",
      "format": "date"
    },
    "period": {
      "type": "string",
      "enum": [
        "day",
        "evening",
        "both"
      ]
    },
    "location": {
      "type": "string"
    },
    "service_details": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "declined",
        "cancelled",
        "expired"
      ],
      "default": "pending"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_by": {
      "type": "string",
      "enum": [
        "extra",
        "caterer"
      ]
    }
  },
  "required": [
    "extra_profile_id",
    "extra_user_id",
    "caterer_id",
    "caterer_name",
    "booking_date",
    "period",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.extra_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.extra_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.extra_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}