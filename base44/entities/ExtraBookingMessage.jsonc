{
  "name": "ExtraBookingMessage",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sender_user_id": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "extra",
        "caterer"
      ]
    },
    "sender_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "read_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "booking_id",
    "members",
    "sender_user_id",
    "sender_role",
    "sender_name",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.members": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}