{
  "name": "WebhookConfig",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "test",
        "production"
      ],
      "default": "production"
    }
  },
  "required": [
    "mode"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}