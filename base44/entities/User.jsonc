{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "suspended"
      ],
      "default": "pending"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "none",
        "bronze",
        "argent",
        "or"
      ],
      "default": "none"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "inactive",
        "trialing",
        "active",
        "past_due",
        "cancelled"
      ],
      "default": "inactive"
    }
  },
  "required": [
    "role"
  ]
}