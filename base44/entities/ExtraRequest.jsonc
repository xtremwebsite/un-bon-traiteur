{
  "name": "ExtraRequest",
  "type": "object",
  "properties": {
    "caterer_id": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "radius_km": {
      "type": "number",
      "default": 15,
      "minimum": 1,
      "maximum": 100
    },
    "required_count": {
      "type": "number"
    },
    "hourly_rate": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "filled",
        "cancelled"
      ],
      "default": "open"
    }
  },
  "required": [
    "caterer_id",
    "role",
    "event_date",
    "location",
    "required_count",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}