{
  "name": "ExtraProfile",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "address": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "changes_requested",
        "rejected",
        "suspended"
      ],
      "default": "pending"
    },
    "admin_comment": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experience_years": {
      "type": "number"
    },
    "experience_details": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "availability_notes": {
      "type": "string"
    },
    "availability_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      }
    },
    "availability_period": {
      "type": "string",
      "enum": [
        "day",
        "evening"
      ],
      "default": "day"
    },
    "availability_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "period": {
            "type": "string",
            "enum": [
              "day",
              "evening",
              "both"
            ]
          }
        },
        "required": [
          "date",
          "period"
        ]
      }
    },
    "mobility_radius_km": {
      "type": "number"
    },
    "transport": {
      "type": "string",
      "enum": [
        "none",
        "public",
        "vehicle",
        "both"
      ]
    },
    "hourly_rate": {
      "type": "number"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "available": {
      "type": "boolean",
      "default": true
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "display_last_name": {
      "type": "boolean",
      "default": false
    },
    "display_email": {
      "type": "boolean",
      "default": false
    },
    "display_phone": {
      "type": "boolean",
      "default": false
    },
    "contact_preference": {
      "type": "string",
      "enum": [
        "site",
        "email"
      ],
      "default": "site"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "free",
        "unlimited"
      ],
      "default": "free"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "inactive",
        "active",
        "past_due",
        "cancelled"
      ],
      "default": "inactive"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email",
    "phone",
    "date_of_birth",
    "address",
    "postal_code",
    "city",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.status": "pending"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}